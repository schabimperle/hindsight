{
  "name": "wealthfolio-hindsight",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Wealthfolio addon: would a different investment have done better with your money?",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:layout": "node scripts/check-layout.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "compare": "tsx scripts/compare.ts",
    "check": "npm run typecheck && npm test && python3 -I scripts/check_oracle.py",
    "fixtures": "python3 -I scripts/check_oracle.py --write",
    "screenshot": "npm run package && node scripts/screenshot.mjs",
    "version": "node scripts/version.mjs && git add manifest.json CHANGELOG.md"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@wealthfolio/addon-sdk": "^3.12.0",
    "@wealthfolio/ui": "^3.12.0",
    "date-fns": "^4.4.0",
    "i18next": "^25.10.10",
    "ignore": "^7.0.14",
    "lucide-react": "^0.561.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "license": "MIT AND AGPL-3.0-only",
  "author": "Malte Schababerle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schabimperle/hindsight.git"
  },
  "homepage": "https://github.com/schabimperle/hindsight",
  "bugs": {
    "url": "https://github.com/schabimperle/hindsight/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
